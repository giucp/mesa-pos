# Local SQLite (default). Prisma CLI resuelve file:./mesa.db → prisma/mesa.db
DATABASE_URL="file:./mesa.db"

# Local o Vercel con Supabase Postgres (recomendado en producción):
# DATABASE_URL = URI pooler Transaction, puerto 6543, añade ?pgbouncer=true si no viene
# DIRECT_URL   = URI directa, puerto 5432 (migraciones)
# DATABASE_URL="postgresql://mesa_runtime.xxxx:CLAVE@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://mesa_runtime:CLAVE@db.xxxx.supabase.co:5432/postgres"

# Genera una clave: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Opcional: URL JSON con { "rate": 148.52, "timestamp": "2026-09-06T12:00:00Z" }
# BCV_RATE_URL=
NEXT_PUBLIC_APP_NAME="Mesa"

# Isolated Fase 6 persistent demo (never olive mesa_runtime / public Café Ávila):
# MESA_ISOLATED_DEMO=1
# MESA_ISOLATED_DATABASE_URL="postgresql://mesa_isolated.xxxx:CLAVE@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=isolated_fase6"
# MESA_ISOLATED_DIRECT_URL="postgresql://mesa_isolated.xxxx:CLAVE@aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require&schema=isolated_fase6"

