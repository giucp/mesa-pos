{
  "name": "mesa-pos-ve",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 43147",
    "build": "tsx scripts/build.ts",
    "start": "next start --port 43147",
    "lint": "eslint",
    "postinstall": "tsx scripts/prisma-with-env.ts generate",
    "db:generate": "tsx scripts/prisma-with-env.ts generate",
    "db:push": "tsx scripts/prisma-with-env.ts db push",
    "db:migrate": "tsx scripts/prisma-with-env.ts migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/prisma-with-env.ts db push --force-reset && tsx prisma/seed.ts",
    "test:phase3": "tsx scripts/phase3-roles.ts",
    "test:settle": "tsx scripts/check-settle.ts",
    "test:phase2-pm-round": "tsx scripts/phase2-pm-round.ts",
    "test:phase4": "tsx scripts/phase4-shift.ts",
    "test:phase5": "tsx scripts/phase5-sync.ts",
    "test:phase6": "tsx scripts/phase6-stock.ts",
    "test:phase6:persist": "tsx scripts/phase6-persistent.ts",
    "test:auth": "node --experimental-test-module-mocks --import tsx scripts/auth-security.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.63.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
